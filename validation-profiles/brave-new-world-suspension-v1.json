{
  "schema_version": "1.0",
  "profile_id": "brave-new-world-suspension-v1",
  "command_policy": {
    "schema_version": "1.0",
    "policy_id": "brave-new-world-suspension-local-v1",
    "rules": [
      {
        "rule_id": "suspension-scenario",
        "argv_prefix": [
          "./bnw",
          "run-scenario",
          "scenarios/suspension-quarter-car.json"
        ],
        "allow_additional_arguments": false,
        "accepted_exit_codes": [0],
        "max_timeout_seconds": 30
      },
      {
        "rule_id": "complete-suite",
        "argv_prefix": ["./bnw", "check"],
        "allow_additional_arguments": false,
        "accepted_exit_codes": [0],
        "max_timeout_seconds": 90
      }
    ],
    "max_timeout_seconds": 90,
    "max_output_bytes_per_stream": 1000000
  },
  "checks": [
    {
      "check_id": "suspension-scenario",
      "title": "四分之一车辆悬架场景契约与无头仿真",
      "argv": [
        "./bnw",
        "run-scenario",
        "scenarios/suspension-quarter-car.json"
      ],
      "cwd": ".",
      "timeout_seconds": 30,
      "required": true
    },
    {
      "check_id": "complete-bnw-suite",
      "title": "BraveNewWorld 完整开发门禁",
      "argv": ["./bnw", "check"],
      "cwd": ".",
      "timeout_seconds": 90,
      "required": true
    }
  ]
}
