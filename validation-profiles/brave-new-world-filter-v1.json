{
  "schema_version": "1.0",
  "profile_id": "brave-new-world-filter-v1",
  "command_policy": {
    "schema_version": "1.0",
    "policy_id": "brave-new-world-filter-local-v1",
    "rules": [
      {
        "rule_id": "filter-scenario",
        "argv_prefix": [
          "./bnw",
          "run-scenario",
          "scenarios/noisy-low-pass.json"
        ],
        "allow_additional_arguments": false,
        "accepted_exit_codes": [
          0
        ],
        "max_timeout_seconds": 15
      },
      {
        "rule_id": "complete-suite",
        "argv_prefix": [
          "./bnw",
          "check"
        ],
        "allow_additional_arguments": false,
        "accepted_exit_codes": [
          0
        ],
        "max_timeout_seconds": 60
      }
    ],
    "max_timeout_seconds": 60,
    "max_output_bytes_per_stream": 1000000
  },
  "checks": [
    {
      "check_id": "filter-scenario",
      "title": "含噪低通场景契约与无头仿真",
