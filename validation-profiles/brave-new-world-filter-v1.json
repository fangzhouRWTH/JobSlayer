        "./bnw",
        "run-scenario",
        "scenarios/noisy-low-pass.json"
      ],
      "cwd": ".",
      "timeout_seconds": 15,
      "required": true
    },
    {
      "check_id": "complete-bnw-suite",
      "title": "BraveNewWorld 完整开发门禁",
      "argv": [
        "./bnw",
        "check"
      ],
      "cwd": ".",
      "timeout_seconds": 60,
      "required": true
    }
  ]
}
