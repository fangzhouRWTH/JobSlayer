{
  "schema_version": "1.0",
  "profile_id": "brave-new-world-v1",
  "command_policy": {
    "schema_version": "1.0",
    "policy_id": "brave-new-world-local-v1",
    "rules": [
      {
        "rule_id": "new-scenario",
        "argv_prefix": [
          "./bnw",
          "run-scenario",
          "scenarios/first-order-slow.json"
        ],
        "allow_additional_arguments": false,
        "accepted_exit_codes": [
          0
        ],
        "max_timeout_seconds": 10
      },
      {
        "rule_id": "complete-suite",
        "argv_prefix": [
          "./bnw",
          "check"
        ],
        "allow_additional_arguments": false,
        "accepted_exit_codes": [
          0
        ],
        "max_timeout_seconds": 30
      }
    ],
    "max_timeout_seconds": 30,
    "max_output_bytes_per_stream": 500000
  },
  "checks": [
    {
      "check_id": "slow-scenario",
      "title": "慢响应场景契约与无头仿真",
      "argv": [
        "./bnw",
        "run-scenario",
        "scenarios/first-order-slow.json"
      ],
      "cwd": ".",
      "timeout_seconds": 10,
      "required": true
    },
    {
      "check_id": "complete-bnw-suite",
      "title": "BraveNewWorld 完整开发门禁",
      "argv": [
        "./bnw",
        "check"
      ],
      "cwd": ".",
      "timeout_seconds": 30,
      "required": true
    }
  ]
}
