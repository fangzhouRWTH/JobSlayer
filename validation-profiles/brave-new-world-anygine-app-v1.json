{
  "schema_version": "1.0",
  "profile_id": "brave-new-world-anygine-app-v1",
  "command_policy": {
    "schema_version": "1.0",
    "policy_id": "brave-new-world-anygine-contract-local-v1",
    "rules": [
      {
        "rule_id": "manifest-contract",
        "argv_prefix": ["./bnw", "contract"],
        "platform_argv_prefixes": {
          "windows": [".\\bnw.cmd", "contract"]
        },
        "allow_additional_arguments": false,
        "accepted_exit_codes": [0],
        "max_timeout_seconds": 30
      },
      {
        "rule_id": "native-build-and-test",
        "argv_prefix": ["./bnw", "test", "--jobs", "4"],
        "platform_argv_prefixes": {
          "windows": [".\\bnw.cmd", "test", "--jobs", "4"]
        },
        "allow_additional_arguments": false,
        "accepted_exit_codes": [0],
        "max_timeout_seconds": 1800
      },
      {
        "rule_id": "native-runtime-smoke",
        "argv_prefix": ["./bnw", "run", "--jobs", "4"],
        "platform_argv_prefixes": {
          "windows": [".\\bnw.cmd", "run", "--jobs", "4"]
        },
        "allow_additional_arguments": false,
        "accepted_exit_codes": [0],
        "max_timeout_seconds": 1800
      }
    ],
    "max_timeout_seconds": 1800,
    "max_output_bytes_per_stream": 2000000
  },
  "checks": [
    {
      "check_id": "manifest-contract",
      "title": "BraveNewWorld Anygine App 清单与公共依赖契约",
      "argv": ["./bnw", "contract"],
      "platform_argv": {
        "windows": [".\\bnw.cmd", "contract"]
      },
      "cwd": ".",
      "timeout_seconds": 30,
      "required": true
    },
    {
      "check_id": "native-build-and-test",
      "title": "BraveNewWorld/Anygine 原生构建与 CTest",
      "argv": ["./bnw", "test", "--jobs", "4"],
      "platform_argv": {
        "windows": [".\\bnw.cmd", "test", "--jobs", "4"]
      },
      "cwd": ".",
      "timeout_seconds": 1800,
      "required": true
    },
    {
      "check_id": "native-runtime-smoke",
      "title": "BraveNewWorld/Anygine 固定帧运行验证",
      "argv": ["./bnw", "run", "--jobs", "4"],
      "platform_argv": {
        "windows": [".\\bnw.cmd", "run", "--jobs", "4"]
      },
      "cwd": ".",
      "timeout_seconds": 1800,
      "required": true
    }
  ]
}
